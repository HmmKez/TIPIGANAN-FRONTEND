# =====================================================================
# PRODUCTION ENV TEMPLATE — TIPIGANAN frontend (Vite)
# ---------------------------------------------------------------------
# Copy this to `.env.production`, set the real API URL, then build:
#     cp .env.production.example .env.production   # edit the value
#     npm run build                                # outputs dist/
# Vite reads `.env.production` automatically for a production build.
#
# NOTE: VITE_ variables are PUBLIC — they are baked into the shipped
# JS bundle. Never put secrets here (there are none for this app).
# =====================================================================

# Full URL of the backend API, including the trailing /api.
# Must match APP_URL on the backend (https). Example:
#   VITE_API_BASE_URL=https://api.repo.example.com/api
VITE_API_BASE_URL=https://CHANGE_ME_API_DOMAIN/api
